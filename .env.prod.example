# Copy to .env.prod, fill in real values, and pass it explicitly on every
# prod command — Compose only auto-loads a file literally named `.env`:
#
#   docker compose -p aria-prod -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# See README.md's "Running prod" section.

# Seeded owner account's initial password (services/core-api/app/seed.py) —
# pick a real one, not the dev default.
CORE_API_ADMIN_PASSWORD=

# MinIO's root user/pass, reused as-is for core-api/worker's S3 access
# key/secret (MinIO's root user acts as an S3 access key). Pick real values,
# not the dev defaults.
MINIO_ROOT_USER=aria
MINIO_ROOT_PASSWORD=

# The domain Caddy gets automatic HTTPS for (Let's Encrypt) and the only
# thing exposed to the host (see docker-compose.prod.yml's `caddy` service
# and ./Caddyfile). Needs a DNS A/AAAA record pointing at this machine's
# public IP, and 80/tcp+443/tcp+udp forwarded to it on your router. Only one
# app can hold host ports 80/443 at a time on this machine — see README.md
# if you also run another Caddy-fronted app here.
CADDY_DOMAIN=aria.roaringpigeon.com

# Must be the origin the frontend is actually served from (CORS) — now
# always the Caddy domain above, since that's the sole public entry point.
FRONTEND_ORIGIN=https://aria.roaringpigeon.com

# Baked into the frontend's JS bundle at *build* time (Vite inlines
# import.meta.env.VITE_*). Paths, not separate origins — Caddy routes
# /api/core/* and /api/ai/* to core-api/ai-service on the same origin as the
# frontend (see ./Caddyfile), which is what keeps this same-origin from the
# browser's point of view (no CORS preflights, plain SameSite=Lax cookies).
# Changing either requires rebuilding the frontend:
#   docker compose -p aria-prod -f docker-compose.prod.yml --env-file .env.prod build frontend
VITE_CORE_API_URL=https://aria.roaringpigeon.com/api/core
VITE_AI_SERVICE_URL=https://aria.roaringpigeon.com/api/ai

# Shared with the dev stack's .env — only needs to be set here too if prod
# should request a different model than whatever the shared `ollama`
# container (docker-compose.llm.yml) already has pulled.
OLLAMA_MODEL=qwen3:14b

# Same as .env.example — leave blank to disable web search.
BRAVE_SEARCH_API_KEY=

# Outbound SMTP relay for the daily overdue-items email digest
# (services/worker/app/tasks/send_overdue_digest.py). Any standard SMTP
# relay works — SES SMTP, SendGrid, Mailgun, a Workspace/Gmail account with
# an app password. Unlike BRAVE_SEARCH_API_KEY there's no "leave blank to
# disable" here: if any household member opts in via /profile with no real
# relay configured, that household's daily send will fail (logged, not
# retried — see send_overdue_digest's per-user try/except). Leaving no
# members opted in is the actual way to "disable" this feature.
WORKER_SMTP_HOST=
WORKER_SMTP_PORT=587
WORKER_SMTP_USERNAME=
WORKER_SMTP_PASSWORD=
WORKER_SMTP_USE_TLS=true
WORKER_SMTP_FROM_ADDRESS=aria@yourdomain.example
